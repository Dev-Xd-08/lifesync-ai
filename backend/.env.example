# Server Port
PORT=5000

# Client Application URL for CORS
CLIENT_URL=http://localhost:5173

# MongoDB Connection String (Local or MongoDB Atlas)
# Example for Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/lifesync_ai?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/lifesync_ai

# JWT Authentication
JWT_SECRET=lifesync_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# Google Gemini API Key for Contextual AI Assistant & Document Extraction
# Leave blank to use built-in intelligent fallback
GEMINI_API_KEY=

# File Upload Storage Directory
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=15
